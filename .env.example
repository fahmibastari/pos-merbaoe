# Salin berkas ini menjadi .env lalu isi nilainya.
# JANGAN pernah meng-commit .env atau berkas apa pun yang memuat kredensial.
# Referensi: README.md §10.2
# ─────────────────────────────────────────────────────────────────────────────

# Koneksi pooler Supabase (port 6543). Dipakai aplikasi saat berjalan.
DATABASE_URL=""

# Koneksi langsung Supabase (port 5432). Dipakai Prisma CLI untuk migrasi
# agar tidak tertahan PgBouncer.
DIRECT_URL=""

# Kunci penandatangan sesi. Minimal 32 byte acak.
# Bangkitkan dengan: openssl rand -base64 32
# Aplikasi sengaja gagal start bila variabel ini kosong.
JWT_SECRET=""
